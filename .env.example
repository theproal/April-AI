# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public HTTPS URL where this app is hosted (Cloud Run / Render / Railway).
# Used for Spotify OAuth callback redirect URI. If omitted, inferred automatically from the request host.
APP_URL="MY_APP_URL"

# PORT & NODE_ENV: Set automatically by Cloud Run / Render / Railway in production.
# PORT="8080"
# NODE_ENV="production"

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Required for linking official Spotify accounts.
# Configure these in the Secrets panel in the AI Studio UI or your hosting environment.
SPOTIFY_CLIENT_ID="MY_SPOTIFY_CLIENT_ID"
SPOTIFY_CLIENT_SECRET="MY_SPOTIFY_CLIENT_SECRET"

# ANDROID_PACKAGE_NAME & ANDROID_SHA256_FINGERPRINT: Optional for PWABuilder TWA fullscreen verification (/.well-known/assetlinks.json).
# ANDROID_PACKAGE_NAME="com.aprilia.app"
# ANDROID_SHA256_FINGERPRINT="AA:BB:CC:..."

