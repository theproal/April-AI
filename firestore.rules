rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'displayName', 'createdAt', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['ownerId', 'email', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'email', 'updatedAt'])
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.updatedAt is timestamp;
    }

    function isValidChatSession(data, userId, chatId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.id == chatId
        && isValidId(data.id)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAttachmentNames(data) {
      return !('attachmentNames' in data)
        || (
          data.attachmentNames is list
          && data.attachmentNames.size() <= 3
          && (
            data.attachmentNames.size() == 0
            || (data.attachmentNames[0] is string && data.attachmentNames[0].size() >= 1 && data.attachmentNames[0].size() <= 200)
          )
        );
    }

    function isValidActionList(data) {
      return !('actions' in data)
        || (
          data.actions is list
          && data.actions.size() <= 5
          && (
            data.actions.size() == 0
            || (
              data.actions[0] is map
              && data.actions[0].keys().hasAll(['id', 'type', 'payload'])
              && data.actions[0].keys().hasOnly(['id', 'type', 'payload', 'status'])
              && data.actions[0].id is string
              && data.actions[0].id.size() <= 128
              && data.actions[0].type is string
              && data.actions[0].type in ['create_task', 'complete_task', 'draft_calendar_event', 'draft_google_task', 'draft_whatsapp_message']
              && data.actions[0].payload is map
              && (!('status' in data.actions[0]) || (data.actions[0].status is string && data.actions[0].status in ['pending', 'executed']))
            )
          )
        );
    }

    function isValidChatMessage(data, userId, chatId, messageId) {
      return data.keys().hasAll(['id', 'ownerId', 'chatId', 'role', 'text', 'timestamp', 'createdAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'chatId', 'role', 'text', 'timestamp', 'attachmentNames', 'actions', 'createdAt'])
        && data.id == messageId
        && isValidId(data.id)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && isValidId(data.ownerId)
        && data.chatId == chatId
        && isValidId(data.chatId)
        && data.role is string
        && data.role in ['user', 'model']
        && data.text is string
        && data.text.size() <= 20000
        && data.timestamp is string
        && data.timestamp.size() <= 24
        && data.createdAt is timestamp
        && isValidAttachmentNames(data)
        && isValidActionList(data);
    }

    match /users/{userId} {
      allow get: if isVerifiedOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(userId)
        && isValidId(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if false;

      match /private/{docId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && docId == 'info';
        allow list: if false;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && docId == 'info'
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }

      match /chats/{chatId} {
        allow get: if isVerifiedOwner(userId) && isValidId(userId) && isValidId(chatId);
        allow list: if isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
        allow create: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && isValidChatSession(incoming(), userId, chatId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && isValidChatSession(incoming(), userId, chatId)
          && incoming().ownerId == existing().ownerId
          && incoming().id == existing().id
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt'])
          );
        allow delete: if isVerifiedOwner(userId)
          && isValidId(userId)
          && isValidId(chatId)
          && existing().ownerId == request.auth.uid;

        match /messages/{messageId} {
          allow get: if isVerifiedOwner(userId)
            && isValidId(userId)
            && isValidId(chatId)
            && isValidId(messageId)
            && get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)).data.ownerId == request.auth.uid;
          allow list: if isVerifiedOwner(userId) && existing().ownerId == request.auth.uid;
          allow create: if isVerifiedOwner(userId)
            && isValidId(userId)
            && isValidId(chatId)
            && isValidId(messageId)
            && isValidChatMessage(incoming(), userId, chatId, messageId)
            && incoming().createdAt == request.time
            && existsAfter(/databases/$(database)/documents/users/$(userId)/chats/$(chatId))
            && getAfter(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)).data.ownerId == request.auth.uid;
          allow update: if isVerifiedOwner(userId)
            && isValidId(userId)
            && isValidId(chatId)
            && isValidId(messageId)
            && isValidChatMessage(incoming(), userId, chatId, messageId)
            && incoming().ownerId == existing().ownerId
            && incoming().id == existing().id
            && incoming().chatId == existing().chatId
            && incoming().role == existing().role
            && incoming().text == existing().text
            && incoming().timestamp == existing().timestamp
            && incoming().createdAt == existing().createdAt
            && incoming().diff(existing()).affectedKeys().hasOnly(['actions'])
            && get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)).data.ownerId == request.auth.uid;
          allow delete: if isVerifiedOwner(userId)
            && isValidId(userId)
            && isValidId(chatId)
            && isValidId(messageId)
            && existing().ownerId == request.auth.uid
            && get(/databases/$(database)/documents/users/$(userId)/chats/$(chatId)).data.ownerId == request.auth.uid;
        }
      }
    }
  }
}
